# Copy this file to .env (or .env.local) and paste your Supabase keys

# Vite client-side (used by the frontend during dev/build)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side (used by server functions / admin operations)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: any other env vars you need (e.g., NEXT_PUBLIC_ANALYTICS_ID)
